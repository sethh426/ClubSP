# ClubSP private environment configuration.
# Copy to .env on the server and keep it outside source control/backups that leave the host.

CLUBSP_ENV=development

# Required for private/production deployment. Use at least 24 unpredictable characters.
CLUBSP_OWNER_SECRET=

# Gmail connection. Read-only is granted first; gmail.send is requested separately
# only when the owner enables approved Relationship Desk sending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAILBOX_EMAIL=

# Required when CLUBSP_ENV=production. Register this exact HTTPS callback with Google.
# Example: https://clubsp.online/auth/gmail/callback
GOOGLE_REDIRECT_URI=
