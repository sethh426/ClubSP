# ClubSP environment configuration
# Keep credentials out of source control.

CLUBSP_ENV=development

# Gmail authorization (read-only; sending and sync are not implemented).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAILBOX_EMAIL=

# Optional canonical HTTPS domain for a private reverse proxy.
# Leave blank for same-computer localhost authorization.
# Setting this does not configure DNS, TLS, or private access by itself.
CLUBSP_GMAIL_ORIGIN=
